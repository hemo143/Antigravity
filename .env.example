SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Email Settings (Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Database (PostgreSQL for production)
# DATABASE_URL=postgres://user:password@localhost:5432/proevent_db

# Eventbrite Integration (التوكن من https://www.eventbrite.com/platform/api-keys)
EVENTBRITE_TOKEN=
# اختياري: لو فاضي هيكتشف المؤسسة تلقائياً
EVENTBRITE_ORG_ID=

# Gmail SMTP لإرسال إيميلات التعاقد (استخدم App Password مش باسورد الجيميل العادي)
# https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=ProEvent <your-email@gmail.com>
# الإيميل اللي يوصله تنبيه بكل طلب تعاقد جديد
CONTRACT_NOTIFICATION_EMAIL=your-email@gmail.com
